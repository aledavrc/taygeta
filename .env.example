# ============================================================================
# Taygeta — example environment variables (section 11.5).
# Copy this file to `.env` and fill in the values at deployment time.
# The real `.env` file must NOT be versioned.
# ============================================================================

# Runtime environment: 'local' or 'production'.
APP_ENV=local

# Database URL. If left empty, DB_PATH (SQLite) is used.
# SQLite example: sqlite:////app/data/taygeta.db
DATABASE_URL=

# Remote LLM for structuring and validation. Fill in at deployment time.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Semantic deduplication via LOCAL embeddings (sentence-transformers).
# Requires no external API or LLM_API_KEY: the model runs in Python and its
# weights are downloaded/cached the first time. Accepts a Hugging Face id or a
# local path.
LLM_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DUPLICATE_SIMILARITY_THRESHOLD=0.90

# Local OCR via an OpenAI-compatible API.
OCR_API_KEY=local-ocr
OCR_BASE_URL=http://ocr:8080/v1
OCR_MODEL=Qwen2-VL-7B-Instruct-Q4_K_M
# Paths inside the persistent 'ocr-models' volume. If they do not exist, they
# are downloaded automatically from the given URLs (Hugging Face).
OCR_MODEL_PATH=/models/Qwen2-VL-7B-Instruct-Q4_K_M.gguf
OCR_MMPROJ_PATH=/models/mmproj-Qwen2-VL-7B-Instruct-f16.gguf
OCR_MODEL_URL=https://huggingface.co/bartowski/Qwen2-VL-7B-Instruct-GGUF/resolve/main/Qwen2-VL-7B-Instruct-Q4_K_M.gguf
OCR_MMPROJ_URL=https://huggingface.co/bartowski/Qwen2-VL-7B-Instruct-GGUF/resolve/main/mmproj-Qwen2-VL-7B-Instruct-f16.gguf
OCR_TIMEOUT_SECONDS=180
OCR_CONTEXT_SIZE=8192
OCR_CONCURRENCY=1
OCR_THREADS=
OCR_PORT=8080

# SQLite and runtime directories.
DB_PATH=/app/data/taygeta.db
DOWNLOADS_DIR=/app/downloads
UPLOADS_DIR=/app/uploads
DOWNLOADS_TTL_SECONDS=3600

# SeaweedFS via the S3 API.
# Credentials must match docker/seaweedfs/s3.json.example.
S3_ENDPOINT_URL=http://seaweedfs-s3:8333
# Public/external endpoint for the UI (rewrites the internal host in links and
# images so they can be opened from the host's browser).
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Public base for composing asset URLs from relative paths
# (e.g. https://assets.example.com). It is concatenated with /buckets/{bucket}/{key}
# when sending the information to the frontend or the MCP client.
S3_PUBLIC_BASE_URL=
S3_BUCKET=taygeta-assets
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_REGION=us-east-1
ASSET_PUBLIC_BASE_URL=
ASSET_URL_TTL_SECONDS=300

# Public addresses of the services, configurable per deployment.
MCP_HOST=0.0.0.0
MCP_PORT=8000
UI_PUBLIC_URL=http://localhost:8501
DOWNLOAD_PUBLIC_URL=http://localhost:8000

# Default language of the HITL interface ('es' or 'en'). Each session can
# change it on the fly from the UI itself.
UI_LANGUAGE=es

# Secret of the UI session cookie (app.storage.user), used to
# persist preferences such as dark mode across reloads. Change it in
# production; if omitted, a default local value is used.
TAYGETA_UI_STORAGE_SECRET=change-me-ui-session-secret

# ROCm override (optional): only applies to docker-compose.rocm.yml.
# Leave it UNDEFINED to use native GPU detection. Do NOT define it
# empty: an empty value breaks detection (llama.cpp would silently fall back to CPU).
# Use it only if ROCm does not recognize the GPU; example for RDNA2 (RX 6800/6900): 10.3.0.
# HSA_OVERRIDE_GFX_VERSION=10.3.0

# AMD architecture to compile in the ROCm image (llama.cpp build).
# gfx1030 = RX 6800/6800XT/6900XT; gfx1100 = RX 7900; gfx1031 = RX 6700.
AMDGPU_TARGETS=gfx1030

# CUDA override: NVIDIA device selection (optional).
# Examples: "all", "0", "0,1" or use device_ids in docker-compose.cuda.yml.
NVIDIA_VISIBLE_DEVICES=all
