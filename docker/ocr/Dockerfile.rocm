# syntax=docker/dockerfile:1
#
# OCR service — AMD/ROCm variant (section 11.3).
# Builds `llama-server` with the HIP backend. The image uses the ROCm runtime,
# which must be compatible with the ROCm version installed on the host.
#
# Host requirements:
#   - AMD driver + ROCm runtime compatible with the base image.
#   - Access to /dev/kfd and /dev/dri (configured by docker-compose.rocm.yml).
#   - User groups in video/render depending on the host distribution.
# Verification: `docker compose -f docker-compose.yml -f docker-compose.rocm.yml \
#   exec ocr llama-server --list-devices` (it must detect the AMD GPU).

FROM rocm/dev-ubuntu-22.04:6.2.2

ARG LLAMA_CPP_REF=b11559
# GPU target(s) to compile. Injected from docker-compose.rocm.yml
# (build.args.AMDGPU_TARGETS); defaults to gfx1030 (RX 6800/6800XT/6900XT).
ARG AMDGPU_TARGETS=gfx1030
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      git cmake build-essential ca-certificates curl libcurl4-openssl-dev \
      hipblas-dev rocblas-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch "${LLAMA_CPP_REF}" https://github.com/ggml-org/llama.cpp.git .
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
      -DGGML_CUDA=OFF -DGGML_HIP=ON \
      -DAMDGPU_TARGETS="${AMDGPU_TARGETS}" -DLLAMA_CURL=ON \
 && cmake --build build --config Release -j"$(nproc)" --target llama-server \
 && install -m 0755 build/bin/llama-server /usr/local/bin/llama-server

# Installs the llama.cpp shared libraries (e.g.
# libllama-server-impl.so) into /usr/local/lib and refreshes the dynamic linker.
# It is done in a separate layer so as not to invalidate the cached HIP build.
RUN cp -a build/bin/*.so* /usr/local/lib/ && ldconfig

COPY docker/ocr/entrypoint.sh /usr/local/bin/ocr-entrypoint
RUN chmod 0755 /usr/local/bin/ocr-entrypoint

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/ocr-entrypoint"]
